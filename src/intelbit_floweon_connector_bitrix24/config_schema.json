{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intelbit.studio/floweon/connector-bitrix24/config.schema.json",
  "title": "Bitrix24 Connector config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "webhook_base_url",
    "event_secret"
  ],
  "properties": {
    "webhook_base_url": {
      "type": "string",
      "format": "uri",
      "description": "URL входящего вебхука коробки: https://<portal>/rest/<user_id>/<token>/"
    },
    "iblock_id": {
      "type": "integer",
      "description": "ID инфоблока торгового каталога (для catalog.*)"
    },
    "price_type_id": {
      "type": "integer",
      "description": "ID типа цены (catalog.priceType) для чтения/записи цен"
    },
    "store_id": {
      "type": [
        "integer",
        "string"
      ],
      "pattern": "^[0-9]+$",
      "description": "ID склада (catalog.store) для upsert остатков store_product по code товара"
    },
    "rate_limit_rps": {
      "type": "number",
      "default": 2,
      "minimum": 0.1,
      "description": "Лимит запросов в секунду к REST Bitrix24"
    },
    "timeout": {
      "type": "number",
      "default": 30,
      "description": "Таймаут HTTP-запроса, сек"
    },
    "event_secret": {
      "type": "string",
      "minLength": 1,
      "description": "Обязательный secret (application token) для проверки исходящих вебхуков; без него коннектор не стартует"
    },
    "ca_bundle": {
      "type": "string",
      "description": "Путь к корпоративному CA для TLS к порталу; пусто — системные сертификаты"
    },
    "verify_ssl": {
      "type": [
        "boolean",
        "string"
      ],
      "default": true,
      "description": "Проверка TLS-сертификата портала; false допускается только с allow_insecure_tls"
    },
    "allow_insecure_tls": {
      "type": [
        "boolean",
        "string"
      ],
      "default": false,
      "description": "Разрешить verify_ssl=false (LAN-стенд с самоподписанным сертификатом)"
    }
  }
}
